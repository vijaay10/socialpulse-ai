# ---------- SocialPulse AI environment ----------
# Copy to .env and adjust. Never commit the real .env.

# MongoDB: local Docker by default. For MongoDB Atlas use:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/socialpulse?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/socialpulse

# Redis (cache only - MongoDB is the source of truth)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=sp
REDIS_COMMAND_TIMEOUT_MS=500

# Cache TTLs (seconds)
CACHE_TTL_TRENDS=60
CACHE_TTL_OVERVIEW=60
CACHE_TTL_SENTIMENT=120
CACHE_TTL_ENGAGEMENT=120
CACHE_TTL_POSTS=30

# Python NLP service
NLP_SERVICE_URL=http://localhost:8000

# Backend
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_PER_MINUTE=300
UPLOAD_MAX_MB=10
# Required in the X-API-Key header for ingestion, cache invalidation and benchmark runs.
ADMIN_API_KEY=change-me-to-a-long-random-string
